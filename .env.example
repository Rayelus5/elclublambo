NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN=lineaSepolia
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: dedicated Linea mainnet RPC used to verify Alpha contracts (defaults to the public RPC)
LINEA_RPC_URL=
# Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys --json
# Leave empty to disable push; the dispatcher then does nothing and the UI hides the switch.
# VAPID_SUBJECT is a mailto: or https: URL. NEXT_PUBLIC_VAPID_PUBLIC_KEY repeats VAPID_PUBLIC_KEY for the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
