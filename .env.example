NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Supabase URL. Empty = the server uses NEXT_PUBLIC_SUPABASE_URL (local, production). Preproduction sets
# the Docker-network URL so its server never goes out through Cloudflare (ISP blocks during LaLiga matches).
SUPABASE_INTERNAL_URL=
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Which chains this build uses: testnet = Base Sepolia + Arbitrum Sepolia (local, e2e, preproduction), mainnet = Base +
# Arbitrum (production). Fixed at build time. Unset or empty is testnet; anything else fails.
NEXT_PUBLIC_NETWORK_SET=testnet
# Base Builder Code (public, from base.dev): it is appended to every transaction sent on Base. Required in production.
NEXT_PUBLIC_BASE_BUILDER_CODE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional but recommended in production: dedicated RPC endpoints (an RPC provider URL with its key). They verify tips,
# bounty payments and donations, and from the cron value the Safe, scan its operations and settle pending donations
# (not Alpha contracts, which use their own public RPC). Empty = the chain's public RPC, which rate-limits
# verification and the cron.
# Base mainnet (chain 8453):
BASE_RPC_URL=
# Arbitrum One (chain 42161):
ARBITRUM_RPC_URL=
# Base Sepolia testnet (chain 84532):
BASE_SEPOLIA_RPC_URL=
# Arbitrum Sepolia testnet (chain 421614):
ARBITRUM_SEPOLIA_RPC_URL=
# Browser RPCs of the wallet and the in-page raffle draw verifier (public: they are inlined in the client bundle, so
# never put a key here and never reuse the ones above). Only for tests/local chains; leave empty in production (the
# public RPC is used, which keeps the check independent of the forum).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
# Optional: confirmations a tip / bounty payment needs before it is credited (integer >= 1). Empty = 3. The cron's Safe
# operations scan also stops this many blocks behind the chain tip.
TIP_CONFIRMATIONS=
# Fund valuation (USDC + ETH + WETH in the Safe at the ETH/USD price). Leave all empty in production: the verified
# addresses in src/lib/economy/networks.ts apply. Overrides for tests and the local chain only, and only for the
# legacy test chain 59141 (the paused DAO): the legacy mainnet (59144) ignores them, so its oracle and WETH cannot be
# swapped by env.
# ETH_USD_FEED_ADDRESS_59141: a Chainlink-compatible ETH/USD aggregator (latestRoundData + decimals).
# WETH_ADDRESS_59141: the WETH token whose Safe balance and transfers are counted.
# COINGECKO_DISABLED=1 turns off the CoinGecko fallback price (used when Chainlink is stale or missing).
ETH_USD_FEED_ADDRESS_59141=
WETH_ADDRESS_59141=
COINGECKO_DISABLED=
# Mercado page (display-only market data). COINGECKO_API_BASE overrides the API root in every environment
# (default https://api.coingecko.com/api/v3; e2e points it at a local mock). COINGECKO_API_KEY is the optional
# CoinGecko demo key, sent as x-cg-demo-api-key.
COINGECKO_API_BASE=
COINGECKO_API_KEY=
# Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys --json
# Leave empty to disable push; the dispatcher then does nothing and the UI hides the switch.
# VAPID_SUBJECT is a mailto: or https: URL. NEXT_PUBLIC_VAPID_PUBLIC_KEY repeats VAPID_PUBLIC_KEY for the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Secret for the cron route /api/cron/dao (GET from Vercel Cron, or POST) (per chain: hourly NAV snapshot, Safe operations scan, settlement of
# pending donations at market NAV).
# Sent as "Authorization: Bearer <value>". Leave empty to disable the route (it answers 503). Generate with: openssl rand -hex 32
CRON_SECRET=
# Checker rate limits by IP (P4-R6): the request header that carries the caller's IP. Empty = the first entry of
# x-forwarded-for (Vercel overwrites it). Preproduction, behind the Cloudflare tunnel, sets cf-connecting-ip.
TRUSTED_IP_HEADER=
# Optional pay-per-query (x402) for the checker API /api/v1/check/*. OFF unless X402_ENABLED=true: no real money without
# the fiscal sign-up. Off, the API is free and limited per IP (60/h).
# X402_NETWORK: eip155:84532 (Base Sepolia, default, public facilitator) or eip155:8453 (Base mainnet, needs both CDP
# keys; without them the API stays free and logs it). X402_PRICE: USD, default $0.01. X402_PAY_TO: default the club
# Safe. X402_FACILITATOR_URL: https facilitator for Base Sepolia, default https://x402.org/facilitator.
X402_ENABLED=
X402_NETWORK=
X402_PRICE=
X402_PAY_TO=
X402_FACILITATOR_URL=
# Coinbase CDP API key (portal.cdp.coinbase.com) for the mainnet x402 facilitator. Secret.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
