NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN=lineaSepolia
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional but recommended in production: dedicated RPC endpoints (an RPC provider URL with its key). They verify Alpha
# contracts (mainnet only), verify tips, bounty payments and donations, settle pending donations and reconcile the Safe
# balance from the cron. Empty = the chain's public RPC, which rate-limits verification and the cron.
# Linea mainnet (chain 59144):
LINEA_RPC_URL=
# Linea Sepolia testnet (chain 59141):
LINEA_SEPOLIA_RPC_URL=
# Optional: confirmations a tip / bounty payment needs before it is credited (integer >= 1). Empty = 3.
TIP_CONFIRMATIONS=
# Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys --json
# Leave empty to disable push; the dispatcher then does nothing and the UI hides the switch.
# VAPID_SUBJECT is a mailto: or https: URL. NEXT_PUBLIC_VAPID_PUBLIC_KEY repeats VAPID_PUBLIC_KEY for the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Secret for the cron route POST /api/cron/dao (settles pending donations and reconciles the Safe balance).
# Sent as "Authorization: Bearer <value>". Leave empty to disable the route (it answers 503). Generate with: openssl rand -hex 32
CRON_SECRET=
