NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN=lineaSepolia
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional but recommended in production: dedicated RPC endpoints (an RPC provider URL with its key). They verify Alpha
# contracts (mainnet only), verify tips, bounty payments and donations, and from the cron value the Safe, scan its
# operations and settle pending donations. Empty = the chain's public RPC, which rate-limits verification and the cron.
# Linea mainnet (chain 59144):
LINEA_RPC_URL=
# Linea Sepolia testnet (chain 59141):
LINEA_SEPOLIA_RPC_URL=
# Optional: confirmations a tip / bounty payment needs before it is credited (integer >= 1). Empty = 3. The cron's Safe
# operations scan also stops this many blocks behind the chain tip.
TIP_CONFIRMATIONS=
# Fund valuation (USDC + ETH + WETH in the Safe at the ETH/USD price). Leave all empty in production: the verified
# addresses in src/lib/economy/networks.ts apply. Overrides for tests and the local chain only, per chain id
# (59144 Linea, 59141 Linea Sepolia), e.g. ETH_USD_FEED_ADDRESS_59141=0x...
# ETH_USD_FEED_ADDRESS_<chainId>: a Chainlink-compatible ETH/USD aggregator (latestRoundData + decimals).
# WETH_ADDRESS_<chainId>: the WETH token whose Safe balance and transfers are counted.
# COINGECKO_DISABLED=1 turns off the CoinGecko fallback price (used when Chainlink is stale or missing).
ETH_USD_FEED_ADDRESS_59144=
ETH_USD_FEED_ADDRESS_59141=
WETH_ADDRESS_59144=
WETH_ADDRESS_59141=
COINGECKO_DISABLED=
# Web Push (VAPID). Generate with: pnpm exec web-push generate-vapid-keys --json
# Leave empty to disable push; the dispatcher then does nothing and the UI hides the switch.
# VAPID_SUBJECT is a mailto: or https: URL. NEXT_PUBLIC_VAPID_PUBLIC_KEY repeats VAPID_PUBLIC_KEY for the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Secret for the cron route POST /api/cron/dao (per chain: hourly NAV snapshot, Safe operations scan, settlement of
# pending donations at market NAV).
# Sent as "Authorization: Bearer <value>". Leave empty to disable the route (it answers 503). Generate with: openssl rand -hex 32
CRON_SECRET=
