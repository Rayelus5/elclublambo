# Preproduction env (pre.elclub.party). Copy to /opt/elclub/pre/web.env on the homelab (chmod 600, owned by the runner
# user) and fill the empty values; never commit the filled file. Same keys as .env.example (see it for what each does).
# The NEXT_PUBLIC_* values are baked into the image at build time (compose build args), the rest are read at runtime.
# Supabase is the self-hosted stack behind the tunnel: the browser uses the public pre-api URL, the server the gateway on
# the supabase_default Docker network (no round trip through Cloudflare, which Spanish ISPs block during LaLiga matches).
NEXT_PUBLIC_SUPABASE_URL=https://pre-api.elclub.party
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INTERNAL_URL=http://kong:8000
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_NETWORK_SET=testnet
# Base Builder Code: optional in preproduction (empty = no code appended).
NEXT_PUBLIC_BASE_BUILDER_CODE=
NEXT_PUBLIC_SITE_URL=https://pre.elclub.party
# Optional: where the proxy fetches its own status pages (503 maintenance / unavailable). Unset = http://127.0.0.1:<port>
# on this bind, which is what PRE needs (the tunnel's X-Forwarded-Proto: https must not reach the internal fetch).
# INTERNAL_ORIGIN=http://127.0.0.1:3000
# Server RPCs: preproduction runs on the two testnets; the mainnet ones stay empty.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
# Browser RPCs: leave empty (the public RPC is used).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
TIP_CONFIRMATIONS=3
# Test/local-chain overrides: leave empty in preproduction.
ETH_USD_FEED_ADDRESS_59141=
WETH_ADDRESS_59141=
COINGECKO_DISABLED=
COINGECKO_API_BASE=
COINGECKO_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Also read by the cron container (Authorization: Bearer). Generate with: openssl rand -hex 32
CRON_SECRET=
# Behind the Cloudflare tunnel the caller's IP is in cf-connecting-ip (x-forwarded-for can be prefixed by the client).
TRUSTED_IP_HEADER=cf-connecting-ip
# x402 off by default. To try it on Base Sepolia: X402_ENABLED=true (the rest empty = public facilitator, $0.01, Safe).
X402_ENABLED=
X402_NETWORK=
X402_PRICE=
X402_PAY_TO=
X402_FACILITATOR_URL=
# Not used on testnet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
