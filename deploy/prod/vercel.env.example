# Production env for the Vercel project (elclub.party). Reference only: set each value in Vercel → Settings →
# Environment Variables, scoped to Production only (F5-R5). Never commit real values. Same keys as .env.example.
# Supabase Cloud project (West EU / Ireland, eu-west-1): replace <ref> with the project ref (Project ID in Settings → General).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty: Vercel reaches Supabase Cloud over its public URL.
SUPABASE_INTERNAL_URL=
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_NETWORK_SET=mainnet
# Base Builder Code (base.dev): required, the production build fails without it.
NEXT_PUBLIC_BASE_BUILDER_CODE=
NEXT_PUBLIC_SITE_URL=https://elclub.party
# Server RPCs (provider URL with its key, Sensitive). Required for the two mainnets.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
# Testnet RPCs: not used by a mainnet build.
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
# Browser RPCs: empty in production (the public RPC is used).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
TIP_CONFIRMATIONS=3
# Not set in production, on purpose: ETH_USD_FEED_ADDRESS_59141, WETH_ADDRESS_59141, COINGECKO_DISABLED and
# COINGECKO_API_BASE are overrides for tests and the local chain only (the verified addresses in
# src/lib/economy/networks.ts and the real CoinGecko API apply).
COINGECKO_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=
# Empty: Vercel overwrites x-forwarded-for with the caller's IP.
TRUSTED_IP_HEADER=
# x402 stays OFF until the fiscal sign-up (D17). Then: X402_ENABLED=true, X402_NETWORK=eip155:8453 and both CDP keys
# (Sensitive); without them the API stays free. X402_FACILITATOR_URL is not used on mainnet (CDP facilitator).
X402_ENABLED=
X402_NETWORK=
X402_PRICE=
X402_PAY_TO=
X402_FACILITATOR_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Vercel installs with the pnpm version pinned in package.json (packageManager: pnpm@12.11.2) only with corepack on.
ENABLE_EXPERIMENTAL_COREPACK=1
