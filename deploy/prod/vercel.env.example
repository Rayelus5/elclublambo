# Production env for the Vercel project (elclub.party). Reference only: set each value in Vercel → Settings →
# Environment Variables, scoped to Production only (F5-R5). Never commit real values. Same keys as .env.example.
# Supabase Cloud project (Frankfurt, eu-central-1): replace <ref> with the project ref.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPER_ADMIN_WALLET=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_CHAIN=linea
NEXT_PUBLIC_SITE_URL=https://elclub.party
LINEA_RPC_URL=
LINEA_SEPOLIA_RPC_URL=
# Browser RPCs of the raffle verifier: empty in production (the public RPC is used).
NEXT_PUBLIC_LINEA_RPC_URL=
NEXT_PUBLIC_LINEA_SEPOLIA_RPC_URL=
TIP_CONFIRMATIONS=
# Not set in production, on purpose: ETH_USD_FEED_ADDRESS_59141, WETH_ADDRESS_59141, COINGECKO_DISABLED and
# COINGECKO_API_BASE are overrides for tests and the local chain only (the verified addresses in
# src/lib/economy/networks.ts and the real CoinGecko API apply).
COINGECKO_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=
# Vercel installs with the pnpm version pinned in package.json (packageManager: pnpm@12.11.2) only with corepack on.
ENABLE_EXPERIMENTAL_COREPACK=1
